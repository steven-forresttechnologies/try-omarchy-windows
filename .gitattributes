app/testdata/SHA256SUMS.* text eol=lf

# Bash runs these on Linux and in Windows MSYS2; CRLF breaks its option parsing.
runtime-build/**/*.sh text eol=lf
scripts/release/**/*.sh text eol=lf

# Runtime patches are digest-pinned and must be byte-identical on Windows.
runtime-build/patches/**/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof

# Unified-diff context lines and format-patch trailers carry intentional spaces.
guest-build/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
scripts/gpu/blender/*.sh text eol=lf
scripts/gpu/blender/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
