From: Try Omarchy contributors
Subject: [PATCH] venus: preserve resource classes for host-pointer memory

The host-pointer allocator selects plain or host-import resources at bind
time. Do not override its plain buffers with opaque external resources or
force host-import images to the linear layout used for opaque exports.

--- a/src/venus/vkr_win32_shim.c
+++ b/src/venus/vkr_win32_shim.c
@@ -194,7 +194,7 @@
    VkExternalMemoryBufferCreateInfo ext_info;
    const VkBufferCreateInfo *create_info = pCreateInfo;
 
-   if (host_type) {
+   if (host_type && !entry->dev->physical_device->host_external_memory_host) {
       bool has_external = false;
       for (const VkBaseInStructure *iter = (const VkBaseInStructure *)pCreateInfo->pNext;
            iter; iter = iter->pNext) {
@@ -232,9 +232,6 @@
    struct vkr_win32_device_entry *entry = vkr_win32_lookup_device(device);
    if (!entry)
       return VK_ERROR_DEVICE_LOST;
-
-   const VkExternalMemoryHandleTypeFlags host_type =
-      vkr_win32_get_host_handle_type(entry->dev);
 
    /* Remap any existing external memory info in the pNext chain */
    vkr_win32_remap_external_handle_types_in_chain(pCreateInfo->pNext);
@@ -274,7 +271,8 @@
          break;
       }
    }
-   if (ext_info && ext_info->handleTypes &&
+   if (ext_info &&
+       (ext_info->handleTypes & VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT) &&
        info_in->tiling != VK_IMAGE_TILING_LINEAR) {
       info_local = *info_in;
       info_local.tiling = VK_IMAGE_TILING_LINEAR;
