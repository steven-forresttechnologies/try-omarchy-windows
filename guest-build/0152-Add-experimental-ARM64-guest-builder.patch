diff --git a/guest/Containerfile-aarch64 b/guest/Containerfile-aarch64
new file mode 100644
index 0000000..4a54f67
--- /dev/null
+++ b/guest/Containerfile-aarch64
@@ -0,0 +1,43 @@
+# ARM bootstrap follows the official multi-architecture Omarchy package builder
+# at omacom-io/omarchy-pkgs commit 7e448b90313fea4fb78da9a78607287691d3b241.
+FROM docker.io/alpine@sha256:ee16d92f96db08d9d2d07da48555a27f3a69d8f0759021dbc601195ed0d2b5bd AS bootstrapper
+
+ARG TARGETARCH
+RUN test "$TARGETARCH" = arm64
+
+RUN apk add --no-cache bash curl gnupg pacman-makepkg zstd
+COPY guest/vendor/omarchy-pkgs/pacstrap-docker /usr/local/bin/pacstrap-docker
+RUN chmod 0755 /usr/local/bin/pacstrap-docker
+
+RUN mkdir -p /etc/pacman.d /usr/share/pacman/keyrings && \
+    printf '[options]\nHoldPkg = pacman glibc\nArchitecture = auto\nSigLevel = Required DatabaseOptional\nLocalFileSigLevel = Optional\n\n[core]\nInclude = /etc/pacman.d/mirrorlist\n\n[extra]\nInclude = /etc/pacman.d/mirrorlist\n\n[alarm]\nInclude = /etc/pacman.d/mirrorlist\n\n[aur]\nInclude = /etc/pacman.d/mirrorlist\n' > /etc/pacman.conf && \
+    printf 'Server = https://arm-mirror.omarchy.org/$arch/$repo\n' | sed 's/\$arch/aarch64/' > /etc/pacman.d/mirrorlist && \
+    for pair in \
+      'archlinuxarm-revoked e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' \
+      'archlinuxarm-trusted f2a7250f2a2b77542f82f4219b2bae7895f27b3dcfdf350b497e2be306af776d' \
+      'archlinuxarm.gpg 6ce771e853f04a38a5b533cb33e61f877b9b06b58b6db051eb8a15d737a2332f'; do \
+      set -- $pair; \
+      curl -fsSL "https://raw.githubusercontent.com/archlinuxarm/PKGBUILDs/0b5418fc3f62860b191cd872cb2f933f9fc77841/core/archlinuxarm-keyring/$1" -o "/usr/share/pacman/keyrings/$1"; \
+      echo "$2  /usr/share/pacman/keyrings/$1" | sha256sum -c -; \
+    done && \
+    pacman-key --init && pacman-key --populate archlinuxarm && \
+    mkdir /rootfs && pacstrap-docker /rootfs base archlinuxarm-keyring && \
+    cp /etc/pacman.conf /rootfs/etc/pacman.conf && \
+    cp /etc/pacman.d/mirrorlist /rootfs/etc/pacman.d/mirrorlist
+
+FROM scratch AS builder
+COPY --from=bootstrapper /rootfs/ /
+
+# Import the reviewed Omarchy packaging key; package signatures stay required.
+COPY guest/keys/omarchy-pkgs.asc /tmp/omarchy-pkgs.asc
+RUN pacman-key --init && pacman-key --populate archlinuxarm && \
+    test "$(gpg --batch --with-colons --show-keys /tmp/omarchy-pkgs.asc | awk -F: '/^fpr:/ { print $10; exit }')" = 40DFB630FF42BCFFB047046CF0134EE680CAC571 && \
+    pacman-key --add /tmp/omarchy-pkgs.asc && \
+    pacman-key --lsign-key 40DFB630FF42BCFFB047046CF0134EE680CAC571 && \
+    rm /tmp/omarchy-pkgs.asc && \
+    pacman -Syu --noconfirm && \
+    pacman -S --needed --noconfirm arch-install-scripts e2fsprogs gcc git python zstd && \
+    pacman -Scc --noconfirm
+
+WORKDIR /workspace
+ENTRYPOINT ["/workspace/guest/build.sh"]
diff --git a/guest/build-container.sh b/guest/build-container.sh
index 643d025..6a97845 100755
--- a/guest/build-container.sh
+++ b/guest/build-container.sh
@@ -18,6 +18,11 @@ dry_run=0
 
 while (($#)); do
   case "$1" in
+    --spec)
+      [[ $# -ge 2 && -n ${2:-} ]] || fail "--spec requires a file"
+      spec=$2
+      shift 2
+      ;;
     --output)
       output=${2:-}
       output_set=1
@@ -39,7 +44,8 @@ while (($#)); do
       cat <<'USAGE'
 Usage: guest/build-container.sh [options]
 
-  --output DIR                   Artifact directory (default: dist/guest)
+  --spec FILE                    Guest spec within guest/ (default: guest/spec.json)
+  --output DIR                   Artifact directory (default: dist/guest or dist/guest-aarch64)
   --work-volume NAME             Persistent Docker build/cache volume
   --refresh-package-lock FILE    Resolve the spec transaction to FILE; do not build
   --dry-run                      Print the selected immutable build plan
@@ -52,8 +58,12 @@ USAGE
   esac
 done
 
-[[ -f $spec ]] || fail "spec not found: $spec"
-container_spec=/workspace/guest/spec.json
+[[ -n $spec && -f $spec && ! -L $spec ]] || fail "spec not found or is a symlink: $spec"
+spec_dir=$(cd "$(dirname "$spec")" && pwd -P)
+guest_physical_dir=$(cd "$guest_dir" && pwd -P)
+[[ $spec_dir == "$guest_physical_dir" ]] || fail "spec must be in guest/"
+spec="$spec_dir/$(basename "$spec")"
+container_spec="/workspace/guest/$(basename "$spec")"
 plan_fields=$(python3 - "$spec" <<'PY'
 import json
 import pathlib
@@ -62,30 +72,91 @@ import sys
 spec = json.loads(pathlib.Path(sys.argv[1]).read_text())
 architecture = spec["image"]["architecture"]
 profile = spec["guest"].get("profile")
-if architecture != "x86_64":
-    raise SystemExit(f"x86 builder requires an x86_64 spec, got {architecture}")
+if architecture not in ("x86_64", "aarch64"):
+    raise SystemExit(f"unsupported guest architecture: {architecture}")
 if profile != "factory":
     raise SystemExit(f"native guest requires the factory profile, got {profile}")
 print(f"{architecture}\t{profile}")
 PY
 ) || fail "invalid native guest spec"
 IFS=$'\t' read -r architecture profile <<<"$plan_fields"
-[[ -n $architecture && -n $profile ]] || fail "could not read x86_64 build spec"
+[[ -n $architecture && -n $profile ]] || fail "could not read guest build spec"
+case "$architecture" in
+  x86_64)
+    platform=linux/amd64
+    containerfile="$guest_dir/Containerfile"
+    builder_image=try-omarchy-guest-builder
+    ;;
+  aarch64)
+    platform=linux/arm64
+    containerfile="$guest_dir/Containerfile-aarch64"
+    builder_image=try-omarchy-guest-builder-aarch64
+    if ((output_set == 0)); then
+      output="$repo_dir/dist/guest-aarch64"
+    fi
+    ;;
+esac
 
 if [[ -n $refresh_package_lock && $output_set == 1 ]]; then
   fail "--output and --refresh-package-lock are mutually exclusive"
 fi
 
+# ARM and x86 images use the same artifact names. Refuse to overwrite an
+# existing directory until ARM release packaging has architecture-aware names.
+if [[ $architecture == aarch64 && -z $refresh_package_lock ]]; then
+  [[ ! -L $output && ( ! -e $output || -d $output ) ]] || fail "ARM output must be a new or empty directory"
+  if [[ -d $output ]]; then
+    existing=$(find "$output" -mindepth 1 -maxdepth 1 -print -quit) || fail "cannot inspect ARM output directory"
+    [[ -z $existing ]] || fail "ARM output must be a new or empty directory"
+  fi
+fi
+
+# Protect ARM artifacts when the x86 builder is pointed at their directory.
+if [[ $architecture == x86_64 && -z $refresh_package_lock && -d $output ]]; then
+  if ! python3 - "$output" <<'PYGUARD'
+import json
+from pathlib import Path
+import sys
+
+output = Path(sys.argv[1])
+identified = False
+for filename, section in (("build-spec.json", "image"), ("guest-manifest.json", "guest")):
+    path = output / filename
+    if path.is_symlink():
+        raise SystemExit(f"refusing symlinked guest metadata: {path}")
+    if not path.exists():
+        continue
+    try:
+        architecture = json.loads(path.read_text())[section]["architecture"]
+    except (OSError, ValueError, KeyError, TypeError):
+        raise SystemExit(f"cannot identify guest architecture in {path}")
+    if architecture != "x86_64":
+        raise SystemExit(f"refusing to overwrite {architecture} guest artifacts in {output}")
+    identified = True
+if not identified:
+    for filename in ("rootfs.ext4", "rootfs.ext4.zst", "vmlinuz-linux", "initramfs-linux.img", "SHA256SUMS"):
+        path = output / filename
+        if path.exists() or path.is_symlink():
+            raise SystemExit(f"cannot identify existing guest artifacts in {output}")
+PYGUARD
+  then
+    exit 2
+  fi
+fi
+
 if [[ -z $work_volume ]]; then
   repo_checksum=$(printf '%s' "$repo_dir" | cksum)
   repo_checksum=${repo_checksum%% *}
   work_volume="try-omarchy-guest-work-$repo_checksum"
+  if [[ $architecture == aarch64 ]]; then
+    work_volume+="-aarch64"
+  fi
 fi
 [[ $work_volume =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || fail "invalid Docker volume name: $work_volume"
 
 if (( dry_run )); then
-  printf 'architecture=%s\nplatform=linux/amd64\nprofile=%s\nspec=%s\noutput=%s\nwork-volume=%s\n' \
-    "$architecture" "$profile" "$spec" "$output" "$work_volume"
+  printf 'architecture=%s\nplatform=%s\nprofile=%s\nspec=%s\noutput=%s\nwork-volume=%s\n' \
+    "$architecture" "$platform" "$profile" "$spec" "$output" "$work_volume"
   if [[ -n $refresh_package_lock ]]; then
     printf 'mode=refresh-package-lock\npackage-lock-output=%s\n' "$refresh_package_lock"
   else
@@ -96,8 +167,7 @@ fi
 
 command -v docker >/dev/null || fail "docker is required"
 
-builder_image=try-omarchy-guest-builder
-docker build --platform linux/amd64 -f "$guest_dir/Containerfile" -t "$builder_image" "$repo_dir"
+docker build --platform "$platform" -f "$containerfile" -t "$builder_image" "$repo_dir"
 builder_digest=$(docker image inspect --format '{{.Id}}' "$builder_image")
 
 if [[ -n $refresh_package_lock ]]; then
@@ -106,7 +176,7 @@ if [[ -n $refresh_package_lock ]]; then
   lock_parent=$(dirname "$refresh_package_lock")
   mkdir -p "$lock_parent"
   lock_parent=$(cd "$lock_parent" && pwd)
-  docker run --rm --platform linux/amd64 \
+  docker run --rm --platform "$platform" \
     --entrypoint /workspace/guest/scripts/refresh-package-lock.sh \
     -e OMARCHY_PACMAN_DISABLE_SANDBOX=1 \
     -v "$repo_dir:/workspace:ro" \
@@ -119,7 +189,7 @@ fi
 mkdir -p "$output"
 output=$(cd "$output" && pwd)
 docker volume create --label dev.tryomarchy.role=guest-work "$work_volume" >/dev/null
-docker run --rm --platform linux/amd64 --privileged \
+docker run --rm --platform "$platform" --privileged \
   -e OMARCHY_BUILDER_IMAGE_DIGEST="$builder_digest" \
   -e OMARCHY_PACMAN_DISABLE_SANDBOX=1 \
   -v "$repo_dir:/workspace:ro" \
