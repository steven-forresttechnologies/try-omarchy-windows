--- /dev/null
+++ b/guest/pacman-aarch64.conf
@@ -0,0 +1,26 @@
+# Architecture-specific repository configuration for the ARM64 guest.
+[options]
+HoldPkg = pacman glibc
+# Keep the guest modules matched to the externally delivered kernel.
+IgnorePkg = linux-aarch64
+Architecture = auto
+CheckSpace
+ParallelDownloads = 5
+DownloadUser = alpm
+SigLevel = Required DatabaseOptional
+LocalFileSigLevel = Optional
+
+[omarchy]
+Server = https://pkgs.omarchy.org/edge/$arch
+
+[core]
+Server = https://arm-mirror.omarchy.org/$arch/$repo
+
+[extra]
+Server = https://arm-mirror.omarchy.org/$arch/$repo
+
+[alarm]
+Server = https://arm-mirror.omarchy.org/$arch/$repo
+
+[aur]
+Server = https://arm-mirror.omarchy.org/$arch/$repo
