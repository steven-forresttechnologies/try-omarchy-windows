diff --git a/guest/tests/test_arm64_build_contract.py b/guest/tests/test_arm64_build_contract.py
new file mode 100644
index 0000000..78da9e2
--- /dev/null
+++ b/guest/tests/test_arm64_build_contract.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Contract tests for the architecture-specific guest inputs."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+
+
+class ArchitectureInputsTest(unittest.TestCase):
+    def test_reviewed_specs_match_their_transaction_and_aquamarine_contract(self):
+        for filename, architecture in (("spec.json", "x86_64"), ("spec-aarch64.json", "aarch64")):
+            with self.subTest(architecture=architecture):
+                spec_path = GUEST / filename
+                spec = json.loads(spec_path.read_text())
+                lock = json.loads((GUEST / spec["inputs"]["packageLock"]).read_text())
+                requested = (GUEST / spec["inputs"]["packages"]).read_bytes()
+                self.assertEqual(spec["image"]["architecture"], architecture)
+                self.assertEqual(lock["architecture"], architecture)
+                self.assertEqual(lock["requestedFileSha256"], hashlib.sha256(requested).hexdigest())
+                subprocess.run([sys.executable, str(GUEST / "scripts/aquamarine-contract.py"), str(spec_path)], check=True, capture_output=True, text=True)
+
+    def test_aquamarine_dependency_validation_uses_numeric_package_release(self):
+        script = (GUEST / "scripts/register-omarchy-runtime.sh").read_text()
+        marker = 'python3 - "$spec" >>"$stage/.PKGINFO" <<\'PY\'\n'
+        code = script.split(marker, 1)[1].split("\nPY\n", 1)[0]
+        with tempfile.TemporaryDirectory() as work:
+            spec_path = Path(work) / "spec.json"
+            for version, accepted in (("0.15.1-1.1", True), ("0.15.1-1.3.1", True), ("0.15.1-1.3", False), ("0.15.1-1.3.1\ndepend = injected", False), ("0.15.1-1.3.1;bad", False)):
+                with self.subTest(version=version):
+                    spec_path.write_text(json.dumps({"supplyChain": {"aquamarine": {"packageVersion": version}}, "upstream": {"integrationDepends": []}}))
+                    result = subprocess.run([sys.executable, "-", str(spec_path)], input=code, text=True, capture_output=True)
+                    self.assertEqual(result.returncode == 0, accepted, result.stderr)
+                    if accepted:
+                        self.assertEqual(result.stdout, f"depend = aquamarine>={version}\n")
+
+    def test_mise_architecture_validation_fails_closed_before_download(self):
+        with tempfile.TemporaryDirectory() as work:
+            work = Path(work)
+            root = work / "root"
+            root.mkdir()
+            bin_dir = work / "bin"
+            bin_dir.mkdir()
+            for name in ("arch-chroot", "curl", "pacman", "zstd"):
+                stub = bin_dir / name
+                stub.write_text("#!/bin/sh\nexit 1\n")
+                stub.chmod(0o755)
+            cfg = work / "pacman.conf"
+            cfg.touch()
+            spec_path = work / "spec.json"
+            for architecture, suffix, should_reach_download in (("x86_64", "x64", True), ("aarch64", "arm64", True), ("aarch64", "x64", False), ("unknown", "arm64", False)):
+                with self.subTest(architecture=architecture, suffix=suffix):
+                    version = "2026.8.11"
+                    spec_path.write_text(json.dumps({"image": {"architecture": architecture, "sourceDateEpoch": 1}, "supplyChain": {"mise": {"version": version, "url": f"https://github.com/jdx/mise/releases/download/v{version}/mise-v{version}-linux-{suffix}.tar.xz", "sha256": "a" * 64, "binarySha256": "b" * 64, "reportedVersion": f"{version} linux-{suffix} (test)", "license": "MIT"}}}))
+                    env = dict(os.environ, PATH=str(bin_dir) + os.pathsep + os.environ.get("PATH", ""))
+                    result = subprocess.run(["bash", str(GUEST / "scripts/register-pinned-mise.sh"), "--root", str(root), "--work", str(work), "--spec", str(spec_path), "--pacman-config", str(cfg)], env=env, text=True, capture_output=True)
+                    self.assertNotEqual(result.returncode, 0)
+                    self.assertEqual("download failed" in result.stderr, should_reach_download, result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/guest/tests/test_build_container_arch.py b/guest/tests/test_build_container_arch.py
new file mode 100644
index 0000000..1d94f46
--- /dev/null
+++ b/guest/tests/test_build_container_arch.py
@@ -0,0 +1,146 @@
+"""Architecture selection never shares the default ARM and x86 build outputs."""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+
+GUEST = Path(__file__).resolve().parents[1]
+
+
+class BuildContainerArchitectureTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.guest = self.root / "guest"
+        self.guest.mkdir()
+        shutil.copy2(GUEST / "build-container.sh", self.guest / "build-container.sh")
+        self.script = self.guest / "build-container.sh"
+        self.spec("spec.json", "x86_64")
+        self.spec("spec-aarch64.json", "aarch64")
+        self.bin = self.root / "bin"
+        self.bin.mkdir()
+        self.docker_log = self.root / "docker.log"
+        docker = self.bin / "docker"
+        docker.write_text('#!/bin/sh\nprintf \'[%s]\\n\' "$@" >>"$DOCKER_LOG"\nif [ "$1" = image ]; then echo sha256:fixture; fi\n')
+        docker.chmod(0o755)
+        self.env = dict(os.environ, PATH=str(self.bin) + os.pathsep + os.environ["PATH"], DOCKER_LOG=str(self.docker_log))
+
+    def spec(self, name, architecture, profile="factory"):
+        path = self.guest / name
+        path.write_text(json.dumps({"image": {"architecture": architecture}, "guest": {"profile": profile}}))
+        return path
+
+    def run_build(self, *args):
+        return subprocess.run([str(self.script), *map(str, args)], cwd=self.root, env=self.env, capture_output=True, text=True)
+
+    def test_defaults_preserve_amd64_and_separate_arm_artifacts(self):
+        x86 = self.run_build("--dry-run")
+        self.assertEqual(x86.returncode, 0, x86.stderr)
+        self.assertIn("architecture=x86_64\nplatform=linux/amd64\n", x86.stdout)
+        self.assertIn("output=" + str(self.root / "dist/guest") + "\n", x86.stdout)
+        arm = self.run_build("--spec", self.guest / "spec-aarch64.json", "--dry-run")
+        self.assertEqual(arm.returncode, 0, arm.stderr)
+        self.assertIn("architecture=aarch64\nplatform=linux/arm64\n", arm.stdout)
+        self.assertIn("output=" + str(self.root / "dist/guest-aarch64") + "\n", arm.stdout)
+        self.assertIn("-aarch64\n", arm.stdout)
+
+    def test_arm_run_passes_native_platform_and_spec_to_docker(self):
+        run = self.run_build("--spec", self.guest / "spec-aarch64.json", "--output", self.root / "out")
+        self.assertEqual(run.returncode, 0, run.stderr)
+        calls = self.docker_log.read_text()
+        self.assertIn("[linux/arm64]", calls)
+        self.assertIn("[try-omarchy-guest-builder-aarch64]", calls)
+        self.assertIn("[" + str(self.guest / "Containerfile-aarch64") + "]", calls)
+        self.assertIn("[/workspace/guest/spec-aarch64.json]", calls)
+        self.assertNotIn("[linux/amd64]", calls)
+
+    def test_arm_refuses_existing_output_before_docker(self):
+        for kind in ("visible", "hidden", "file", "symlink"):
+            with self.subTest(kind=kind):
+                output = self.root / kind
+                if kind in ("visible", "hidden"):
+                    output.mkdir()
+                    (output / ("asset" if kind == "visible" else ".asset")).write_text("keep")
+                elif kind == "file":
+                    output.write_text("keep")
+                else:
+                    output.symlink_to(self.root / "missing")
+                result = self.run_build("--spec", self.guest / "spec-aarch64.json", "--output", output)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn("new or empty", result.stderr)
+                self.assertFalse(self.docker_log.exists())
+
+    def test_amd64_refuses_arm_metadata_before_docker(self):
+        for filename, section in (("build-spec.json", "image"), ("guest-manifest.json", "guest")):
+            with self.subTest(filename=filename):
+                output = self.root / filename
+                output.mkdir()
+                (output / filename).write_text(json.dumps({section: {"architecture": "aarch64"}}))
+                result = self.run_build("--output", output)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn("refusing to overwrite", result.stderr)
+                self.assertFalse(self.docker_log.exists())
+
+    def test_amd64_allows_own_metadata_and_rejects_invalid_metadata(self):
+        output = self.root / "rerun"
+        output.mkdir()
+        metadata = output / "build-spec.json"
+        metadata.write_text(json.dumps({"image": {"architecture": "x86_64"}}))
+        self.assertEqual(self.run_build("--output", output).returncode, 0)
+        self.docker_log.unlink()
+        metadata.write_text("invalid")
+        result = self.run_build("--output", output)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("cannot identify", result.stderr)
+        self.assertFalse(self.docker_log.exists())
+
+    def test_amd64_refuses_unidentified_partial_guest_before_work(self):
+        for filename in ("rootfs.ext4", "rootfs.ext4.zst", "vmlinuz-linux", "initramfs-linux.img", "SHA256SUMS"):
+            with self.subTest(filename=filename):
+                output = self.root / filename
+                output.mkdir()
+                (output / filename).write_text("partial")
+                result = self.run_build("--output", output)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn("cannot identify existing guest", result.stderr)
+                self.assertFalse(self.docker_log.exists())
+
+    def test_arm_lock_refresh_uses_selected_spec(self):
+        target = self.root / "lock.json"
+        run = self.run_build("--spec", self.guest / "spec-aarch64.json", "--refresh-package-lock", target)
+        self.assertEqual(run.returncode, 0, run.stderr)
+        calls = self.docker_log.read_text()
+        self.assertIn("[linux/arm64]", calls)
+        self.assertIn("[/workspace/guest/scripts/refresh-package-lock.sh]", calls)
+        self.assertIn("[/workspace/guest/spec-aarch64.json]", calls)
+        self.assertIn("[/lock-output/lock.json]", calls)
+
+    def test_rejects_unknown_architecture_nonfactory_and_external_spec(self):
+        for path in (self.spec("bad.json", "arm64"), self.spec("profile.json", "aarch64", "personal")):
+            run = self.run_build("--spec", path, "--dry-run")
+            self.assertNotEqual(run.returncode, 0)
+        outside = self.root / "outside.json"
+        outside.write_text((self.guest / "spec-aarch64.json").read_text())
+        run = self.run_build("--spec", outside, "--dry-run")
+        self.assertNotEqual(run.returncode, 0)
+        link = self.guest / "alias.json"
+        link.symlink_to(outside)
+        self.assertNotEqual(self.run_build("--spec", link, "--dry-run").returncode, 0)
+
+    def test_amd64_run_keeps_existing_platform_and_spec(self):
+        run = self.run_build("--output", self.root / "out")
+        self.assertEqual(run.returncode, 0, run.stderr)
+        calls = self.docker_log.read_text()
+        self.assertIn("[linux/amd64]", calls)
+        self.assertIn("[try-omarchy-guest-builder]", calls)
+        self.assertIn("[/workspace/guest/spec.json]", calls)
+        self.assertNotIn("[linux/arm64]", calls)
+
+
+if __name__ == "__main__":
+    unittest.main()
