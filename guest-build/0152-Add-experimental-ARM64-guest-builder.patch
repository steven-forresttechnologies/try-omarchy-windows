index 6cdd032..abd1d3c 100755
--- a/guest/build.sh
+++ b/guest/build.sh
@@ -203,7 +203,22 @@ python3 "$guest_dir/scripts/resolve-package-lock.py" \
 # pacstrap reads configured CacheDir paths for host-cache mode only with -P.
 # The copied builder config is replaced by configure-rootfs below. Archives
 # remain under $work across failed staging roots and are still signature-checked.
-pacstrap -c -P -C "$pacman_config" -K -M "$root" "${packages[@]}"
+if [[ $architecture == aarch64 ]]; then
+  # Initialize a new guest keyring, then populate both reviewed signing keys.
+  # Arch Linux ARM has a different keyring from the x86 builder.
+  install -d -m 0755 "$root/etc/pacman.d"
+  pacman-key --gpgdir "$root/etc/pacman.d/gnupg" --init
+  pacman-key --gpgdir "$root/etc/pacman.d/gnupg" --populate archlinuxarm
+  omarchy_key="$guest_dir/keys/omarchy-pkgs.asc"
+  omarchy_fingerprint=40DFB630FF42BCFFB047046CF0134EE680CAC571
+  [[ $(gpg --batch --with-colons --show-keys "$omarchy_key" | awk -F: '/^fpr:/ { print $10; exit }') == "$omarchy_fingerprint" ]] \
+    || fail "Omarchy packaging key fingerprint mismatch"
+  pacman-key --gpgdir "$root/etc/pacman.d/gnupg" --add "$omarchy_key"
+  pacman-key --gpgdir "$root/etc/pacman.d/gnupg" --lsign-key "$omarchy_fingerprint"
+  pacstrap -c -P -C "$pacman_config" -G -M "$root" "${packages[@]}"
+else
+  pacstrap -c -P -C "$pacman_config" -K -M "$root" "${packages[@]}"
+fi
 
 # Fail before image packing if the repository's prebuilt Quickshell and the
 # reviewed Qt private ABI set cannot actually load together.
